{
  "start": "-PT15M",
  "periodOverride": "inherit",
  "widgets": [
    {"type": "text", "x": 0, "y": 0, "width": 24, "height": 2,
     "properties": {"background": "transparent", "markdown": "## Station · what the model decides, without the audio\n**1 · Input** is the sensor telling the truth? · **2 · Output** did what it decides change? · **3 · Authenticity** is it the model we shipped? · **Gate** what triggers the rollback, and how long each pump was offline"}},

    {"type": "alarm", "x": 0, "y": 2, "width": 6, "height": 4,
     "properties": {"title": "Gate · rollback alarm", "region": "__REGION__",
       "alarms": ["arn:aws:cloudwatch:__REGION__:__ACCOUNT__:alarm:station-missed-faults"]}},
    {"type": "metric", "x": 6, "y": 2, "width": 6, "height": 4,
     "properties": {"title": "Clips per version", "region": "__REGION__", "view": "singleValue", "stat": "Sum", "period": 60, "setPeriodToTimeRange": true,
       "metrics": [["__NS__", "Inferences", "Version", "1.0.0", {"label": "v1.0.0"}], ["...", "2.0.0", {"label": "v2.0.0"}]]}},
    {"type": "metric", "x": 12, "y": 2, "width": 6, "height": 4,
     "properties": {"title": "Alerts", "region": "__REGION__", "view": "singleValue", "stat": "Sum", "period": 60, "setPeriodToTimeRange": true,
       "metrics": [["__NS__", "Alerts", "Device", "pump-01", {"label": "01"}], ["...", "pump-02", {"label": "02"}], ["...", "pump-03", {"label": "03"}],
                   ["...", "pump-04", {"label": "04"}], ["...", "pump-05", {"label": "05"}]]}},
    {"type": "metric", "x": 18, "y": 2, "width": 6, "height": 4,
     "properties": {"title": "Faults nobody heard", "region": "__REGION__", "view": "singleValue", "stat": "Sum", "period": 60, "setPeriodToTimeRange": true,
       "metrics": [["__NS__", "MissedFaults", {"label": "missed faults", "color": "#C2410C"}]]}},

    {"type": "text", "x": 0, "y": 6, "width": 24, "height": 1,
     "properties": {"background": "transparent", "markdown": "### 1 · Input · is the sensor telling the truth? A slow rise: the mic is aging. A sudden jump: broken, or someone tampered with it."}},
    {"type": "metric", "x": 0, "y": 7, "width": 16, "height": 6,
     "properties": {"title": "Input level per pump (std devs from what it learned)", "region": "__REGION__", "view": "timeSeries", "stat": "Average", "period": 60,
       "yAxis": {"left": {"min": 0}},
       "metrics": [["__NS__", "InputZ", "Device", "pump-01"], ["...", "pump-02"], ["...", "pump-03"], ["...", "pump-04"], ["...", "pump-05"]]}},
    {"type": "metric", "x": 16, "y": 7, "width": 8, "height": 6,
     "properties": {"title": "Fleet average vs worst clip", "region": "__REGION__", "view": "timeSeries", "stat": "Average", "period": 60,
       "yAxis": {"left": {"min": 0}},
       "metrics": [["__NS__", "InputZ", {"label": "fleet average"}],
                   ["__NS__", "InputZ", {"stat": "Maximum", "label": "worst clip", "color": "#D97706"}]]}},

    {"type": "text", "x": 0, "y": 13, "width": 24, "height": 1,
     "properties": {"background": "transparent", "markdown": "### 2 · Output · did what it decides change? Compare the score distribution between versions (PSI) and the alerts per pump, no labels needed."}},
    {"type": "metric", "x": 0, "y": 14, "width": 8, "height": 6,
     "properties": {"title": "Score vs threshold, per version", "region": "__REGION__", "view": "timeSeries", "stat": "Average", "period": 60,
       "yAxis": {"left": {"min": 0}},
       "metrics": [
         ["__NS__", "Score", "Version", "1.0.0", {"label": "score v1.0.0", "color": "#2448FF"}],
         ["...", "2.0.0", {"label": "score v2.0.0", "color": "#6D28D9"}],
         ["__NS__", "Threshold", "Version", "1.0.0", {"label": "threshold v1.0.0", "color": "#9DB0FF"}],
         ["...", "2.0.0", {"label": "threshold v2.0.0", "color": "#C4B5FD"}]]}},
    {"type": "metric", "x": 8, "y": 14, "width": 8, "height": 6,
     "properties": {"title": "Alerts per pump (per minute)", "region": "__REGION__", "view": "timeSeries", "stacked": false, "stat": "Sum", "period": 60,
       "metrics": [["__NS__", "Alerts", "Device", "pump-01"], ["...", "pump-02"], ["...", "pump-03"], ["...", "pump-04"], ["...", "pump-05"]]}},
    {"type": "log", "x": 16, "y": 14, "width": 8, "height": 6,
     "properties": {"title": "Score distribution per version (clips per bin)", "region": "__REGION__", "view": "bar",
       "query": "SOURCE '/station/events' | fields concat(model_version, ' · ', floor(score * 20) / 20) as bin | stats count(*) as clips by bin | sort bin asc"}},

    {"type": "text", "x": 0, "y": 20, "width": 24, "height": 1,
     "properties": {"background": "transparent", "markdown": "### 3 · Authenticity · is it the model we shipped? Every event carries its version and the sha256 of model.onnx: one hash per version, and it must match the registry."}},
    {"type": "log", "x": 0, "y": 21, "width": 12, "height": 6,
     "properties": {"title": "The fleet now: version and fingerprint per pump", "region": "__REGION__", "view": "table",
       "query": "SOURCE '/station/events' | stats latest(model_version) as version, latest(substr(sha256, 0, 12)) as fingerprint, count(*) as clips, max(input_z) as max_input, max(arrived_ts) as last_ms by device | fields fromMillis(last_ms) as last_seen | display device, version, fingerprint, clips, max_input, last_seen | sort device asc"}},
    {"type": "log", "x": 12, "y": 21, "width": 4, "height": 6,
     "properties": {"title": "Hashes per version (must be 1)", "region": "__REGION__", "view": "table",
       "query": "SOURCE '/station/events' | stats count_distinct(sha256) as hashes, count(*) as clips by model_version | sort model_version asc"}},
    {"type": "metric", "x": 16, "y": 21, "width": 8, "height": 6,
     "properties": {"title": "Which version runs where? · clips per version", "region": "__REGION__", "view": "timeSeries", "stacked": true, "stat": "Sum", "period": 60,
       "metrics": [["__NS__", "Inferences", "Version", "1.0.0"], ["...", "2.0.0"]]}},

    {"type": "text", "x": 0, "y": 27, "width": 24, "height": 1,
     "properties": {"background": "transparent", "markdown": "### Gate and network · the faults nobody heard trigger the rollback · arrived_ts − ts is how long a pump was offline"}},
    {"type": "metric", "x": 0, "y": 28, "width": 8, "height": 6,
     "properties": {"title": "Faults nobody heard · what triggers the rollback", "region": "__REGION__", "view": "timeSeries", "stacked": false,
       "annotations": {"alarms": ["arn:aws:cloudwatch:__REGION__:__ACCOUNT__:alarm:station-missed-faults"]}}},
    {"type": "log", "x": 8, "y": 28, "width": 8, "height": 6,
     "properties": {"title": "Seconds offline per pump (arrived late)", "region": "__REGION__", "view": "timeSeries", "stacked": false,
       "query": "SOURCE '/station/events' | filter ispresent(arrived_ts) | fields (arrived_ts - ts) / 1000 as offline_s | stats max(offline_s) as offline by bin(1m), device"}},
    {"type": "metric", "x": 16, "y": 28, "width": 8, "height": 6,
     "properties": {"title": "How fast? · latency (ms)", "region": "__REGION__", "view": "timeSeries", "stat": "Average", "period": 60,
       "yAxis": {"left": {"min": 0}},
       "metrics": [["__NS__", "LatencyMs", {"label": "average"}], ["__NS__", "LatencyMs", {"stat": "p99", "label": "p99"}]]}}
  ]
}
