#!/bin/bash
# First boot of the EC2 that hosts the pumps (Amazon Linux 2023).
set -euxo pipefail

dnf install -y docker git jq
systemctl enable --now docker
usermod -aG docker ec2-user
usermod -aG docker ssm-user 2>/dev/null || true

# What ./fleet/up.sh and the demo scripts read in every session
cat > /etc/profile.d/station.sh <<'EOF'
export REGION=${region}
export AWS_REGION=${region}
export AWS_DEFAULT_REGION=${region}
export BUCKET=${bucket}
export IDENTITY=terraform
alias fetch-poc='aws s3 sync s3://${bucket}/repo/ ~/poc-devopsdays --delete --exact-timestamps && chmod +x ~/poc-devopsdays/fleet/*.sh ~/poc-devopsdays/demo/*.sh ~/poc-devopsdays/cloud/*.sh'
EOF
chmod 644 /etc/profile.d/station.sh
