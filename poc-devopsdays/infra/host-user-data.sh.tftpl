#!/bin/bash
# Primer arranque de la EC2 que hospeda las bombas (Amazon Linux 2023).
set -euxo pipefail

dnf install -y docker git jq
systemctl enable --now docker
usermod -aG docker ec2-user
usermod -aG docker ssm-user 2>/dev/null || true

# Lo que leen ./fleet/up.sh y los scripts de la demo en cada sesión
cat > /etc/profile.d/estacion.sh <<'EOF'
export REGION=${region}
export AWS_REGION=${region}
export AWS_DEFAULT_REGION=${region}
export BUCKET=${bucket}
export IDENTIDAD=terraform
alias traer-poc='aws s3 sync s3://${bucket}/repo/ ~/poc-devopsdays --delete --exact-timestamps && chmod +x ~/poc-devopsdays/fleet/*.sh ~/poc-devopsdays/demo/*.sh ~/poc-devopsdays/cloud/*.sh'
EOF
chmod 644 /etc/profile.d/estacion.sh
